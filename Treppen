        formula: "m = n - 1 = 15",
        explanation: "Die Anzahl der Auftritte ist normalerweise um eins kleiner als die Anzahl der Steigungen."
      },

      {
        question: "Wie berechnet man die Lauflänge?",
        answers: [
          "L = h · n",
          "L = a · m",
          "L = H + a",
          "L = a - m"
        ],
        correct: 1,
