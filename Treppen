    let currentQuestion = 0;
    let points = 0;
    let answered = false;

    const quizBox = document.getElementById("quizBox");
    const resultBox = document.getElementById("resultBox");
    const questionCount = document.getElementById("questionCount");
    const questionElement = document.getElementById("question");
    const formulaElement = document.getElementById("formula");
    const answersElement = document.getElementById("answers");
    const feedbackElement = document.getElementById("feedback");
    const nextButton = document.getElementById("nextButton");
    const progressElement = document.getElementById("progress");
    const scoreElement = document.getElementById("score");
    const resultTextElement = document.getElementById("resultText");
    const restartButton = document.getElementById("restartButton");

    function showQuestion() {
      const item = questions[currentQuestion];

      answered = false;

      questionCount.textContent =
        `Frage ${currentQuestion + 1} von ${questions.length}`;

      questionElement.textContent = item.question;

      formulaElement.textContent = item.formula || "";

      feedbackElement.textContent = "";
      feedbackElement.style.color = "";

      answersElement.innerHTML = "";

      nextButton.style.display = "none";

      const progress =
        (currentQuestion / questions.length) * 100;

      progressElement.style.width = `${progress}%`;

      item.answers.forEach((answer, index) => {
        const button = document.createElement("button");

        button.className = "answer";
        button.textContent =
          `${String.fromCharCode(65 + index)}) ${answer}`;

        button.addEventListener("click", () => {
          selectAnswer(index, button);
        });

        answersElement.appendChild(button);
      });
    }

    function selectAnswer(selectedIndex, selectedButton) {
      if (answered) {
        return;
      }

      answered = true;

      const item = questions[currentQuestion];
      const allButtons = document.querySelectorAll(".answer");

      allButtons.forEach((button, index) => {
        button.disabled = true;

        if (index === item.correct) {
          button.classList.add("correct");
        }
      });

      if (selectedIndex === item.correct) {
        points++;
        selectedButton.classList.add("correct");

        feedbackElement.textContent =
          `Richtig! ${item.explanation}`;

        feedbackElement.style.color = "#16803c";
      } else {
        selectedButton.classList.add("wrong");

        feedbackElement.textContent =
          `Leider falsch. ${item.explanation}`;

        feedbackElement.style.color = "#c62828";
      }

      nextButton.style.display = "inline-block";

      nextButton.textContent =
        currentQuestion === questions.length - 1
          ? "Ergebnis anzeigen"
          : "Nächste Frage";
    }

    function showResult() {
      quizBox.style.display = "none";
      resultBox.style.display = "block";
      progressElement.style.width = "100%";

      scoreElement.textContent =
        `${points} von ${questions.length} Punkten`;

      const percentage =
        Math.round((points / questions.length) * 100);

      if (percentage >= 90) {
        resultTextElement.textContent =
          "Hervorragend! Du beherrschst die Grundlagen des Treppenbaus sehr sicher.";
      } else if (percentage >= 70) {
        resultTextElement.textContent =
