        explanation: "Die richtige Steigungshöhe beträgt 17,5 cm."
      },

      {
        question: "Wie groß ist der Auftritt bei einer Steigung von 17,5 cm?",
        answers: [
          "25 cm",
          "26 cm",
          "28 cm",
          "30 cm"
        ],
        correct: 2,
